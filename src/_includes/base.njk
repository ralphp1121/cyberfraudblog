<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Cyber Fraud &amp; Bot Attacks Blog</title>
  <meta name="description" content="Bot-driven fraud in e-commerce and online travel, and how AI is reshaping both the attacks and the defenses.">
  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="site-title" href="/">Cyber Fraud &amp; Bot Attacks Blog</a>
      <nav class="site-nav">
        <a href="/">Latest Posts</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {{ buildYear }} Cyber Fraud &amp; Bot Attacks Blog. Reporting on bot-driven fraud and the AI arms race behind it.</p>
    </div>
  </footer>
